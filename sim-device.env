# Default simulator sim.sh/build.sh/test.sh boot and target when no
# -d/--device override is given on the command line. Keep this in sync with
# whatever's actually in use for the App Store screenshot workflow -- see
# docs/SCREENSHOTS.md. Edit + commit this file to change the default for
# everyone; for a personal-only override (e.g. testing on a smaller phone),
# set SIM_DEVICE in local.env instead, which is gitignored and takes
# precedence over this file.
SIM_DEVICE="iPhone 17 Pro Max"
